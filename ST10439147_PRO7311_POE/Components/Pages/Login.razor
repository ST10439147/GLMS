@page "/login"
@using ST10439147_PRO7311_POE.Models
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject UserState UserState

<PageTitle>Login – GLMS</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <div class="brand-logo">📋</div>
            <h1>GLMS</h1>
            <p>Global Contract Management System</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="alert alert-danger">⚠️ @_errorMsg</div>
        }

        <div class="form-group" style="margin-bottom:1rem">
            <label for="username">Username <span class="required">*</span></label>
            <input id="username" class="form-control @(_submitted && string.IsNullOrWhiteSpace(_username) ? "invalid" : "")"
                   type="text"
                   placeholder="Enter your username"
                   @bind="_username"
                   @onkeydown="HandleKeyDown" />
            @if (_submitted && string.IsNullOrWhiteSpace(_username))
            {
                <span class="validation-message">Username is required.</span>
            }
        </div>

        <div class="form-group" style="margin-bottom:1.4rem">
            <label for="password">Password <span class="required">*</span></label>
            <input id="password" class="form-control @(_submitted && string.IsNullOrWhiteSpace(_password) ? "invalid" : "")"
                   type="password"
                   placeholder="Enter your password"
                   @bind="_password"
                   @onkeydown="HandleKeyDown" />
            @if (_submitted && string.IsNullOrWhiteSpace(_password))
            {
                <span class="validation-message">Password is required.</span>
            }
        </div>

        <button class="btn btn-primary btn-lg" style="width:100%" @onclick="DoLogin" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner"></span>
                <span>Signing in...</span>
            }
            else
            {
                <span>🔑 Sign In</span>
            }
        </button>
    </div>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _errorMsg = string.Empty;
    private bool _loading;
    private bool _submitted;

    protected override void OnInitialized()
    {
        // Already logged in → redirect to dashboard
        if (UserState.IsLoggedIn)
            Nav.NavigateTo("/");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    private async Task DoLogin()
    {
        _submitted = true;
        _errorMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
            return;

        _loading = true;

        try
        {
            var payload = new { UserName = _username, Password = _password };
            var response = await Http.PostAsJsonAsync("api/user/Login", payload);

            if (response.IsSuccessStatusCode)
            {
                var user = await response.Content.ReadFromJsonAsync<User>();
                if (user != null)
                {
                    UserState.CurrentUser = user;
                    Nav.NavigateTo("/");
                    return;
                }
            }

            _errorMsg = "Invalid username or password. Please try again.";
        }
        catch
        {
            _errorMsg = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }
}
