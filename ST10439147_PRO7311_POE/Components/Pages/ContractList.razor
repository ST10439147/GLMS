@page "/contracts"
@using ST10439147_PRO7311_POE.Models
@inject HttpClient Http
@rendermode InteractiveServer
@inject ProtectedSessionStorage SessionStorage
@inject UserState UserState
@inject NavigationManager Nav

<PageTitle>Contracts – TechMove</PageTitle>

@if (!_sessionChecked)
{
    <div class="alert alert-info">Loading...</div>
}
else if (!UserState.IsLoggedIn)
{
    <div class="alert alert-info">Redirecting...</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Contracts</h1>
            <p>Manage and track all contracts.</p>
        </div>
        @if (UserState.IsManager)
        {
            <a class="btn btn-primary" href="contracts/create">➕ New Contract</a>
        }
    </div>

    <div class="filter-bar">
        <div class="filter-group">
            <label>Start Date From</label>
            <input type="date" class="form-control" @bind="_filterFrom" />
        </div>
        <div class="filter-group">
            <label>Start Date To</label>
            <input type="date" class="form-control" @bind="_filterTo" />
        </div>
        <div class="filter-group">
            <label>Status</label>
            <select class="form-select" @bind="_filterStatus">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<ContractStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div style="display:flex;gap:.6rem;align-items:flex-end">
            <button class="btn btn-primary" @onclick="ApplyFilter">🔍 Search</button>
            <button class="btn btn-secondary" @onclick="ClearFilter">✕ Clear</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_alertMsg))
    {
        <div class="alert @_alertClass">@_alertMsg</div>
    }

    <div class="card">
        <div class="card-header">
            📄 Contracts
            <span style="font-size:.8rem;font-weight:400;color:#6c757d">@_contracts.Count result(s)</span>
        </div>
        <div class="card-body" style="padding:0">
            @if (_loading)
            {
                <div class="empty-state"><span class="spinner dark"></span></div>
            }
            else if (!_contracts.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📋</div>
                    <h3>No contracts found</h3>
                    <p>Try adjusting your filters or create a new contract.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Client</th>
                                <th>Service Level</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th style="text-align:right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _contracts)
                            {
                                <tr>
                                    <td style="color:#6c757d;font-size:.85rem">@c.Id</td>
                                    <td><strong>@c.Title</strong></td>
                                    <td>@(c.Client?.Name ?? "—")</td>
                                    <td>@c.ServiceLevel</td>
                                    <td><span class="badge badge-@c.Status.ToString().ToLower()">@c.Status</span></td>
                                    <td>@c.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@c.EndDate.ToString("dd MMM yyyy")</td>
                                    <td style="text-align:right">
                                        <div style="display:flex;gap:.4rem;justify-content:flex-end">
                                            <a class="btn btn-sm btn-outline-primary" href="contracts/@c.Id">View</a>
                                            @if (UserState.IsManager)
                                            {
                                                <a class="btn btn-sm btn-warning" href="contracts/@c.Id/edit">Edit</a>
                                            }
                                            @if (UserState.IsAdmin)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(c)">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_deleteTarget != null)
    {
        <div class="modal-overlay">
            <div class="modal-box">
                <h4>⚠️ Delete Contract?</h4>
                <p>Are you sure you want to delete <strong>@_deleteTarget.Title</strong>? This action cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteContract" disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {

                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Contract> _contracts = new();
    private bool _loading = true;
    private bool _deleting;
    private bool _sessionChecked;
    private Contract? _deleteTarget;

    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private string _filterStatus = string.Empty;
    private string _alertMsg = string.Empty;
    private string _alertClass = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sessionChecked)
        {
            _sessionChecked = true;
            if (!UserState.IsLoggedIn)
            {
                try
                {
                    var result = await SessionStorage.GetAsync<User>("currentUser");
                    if (result.Success && result.Value != null)
                        UserState.CurrentUser = result.Value;
                    else
                    { Nav.NavigateTo("/login"); return; }
                }
                catch { Nav.NavigateTo("/login"); return; }
            }
            await LoadContracts();
            StateHasChanged();
        }
    }

    private async Task LoadContracts()
    {
        _loading = true;
        try { _contracts = await Http.GetFromJsonAsync<List<Contract>>("api/v1/contract/All") ?? new(); }
        catch { ShowAlert("Failed to load contracts.", "alert-danger"); }
        finally { _loading = false; }
    }

    private async Task ApplyFilter()
    {
        _loading = true;
        try
        {
            var qs = new List<string>();
            if (_filterFrom.HasValue) qs.Add($"startFrom={_filterFrom.Value:yyyy-MM-dd}");
            if (_filterTo.HasValue) qs.Add($"startTo={_filterTo.Value:yyyy-MM-dd}");
            if (!string.IsNullOrEmpty(_filterStatus)) qs.Add($"status={_filterStatus}");
            var url = "api/v1/contract/Search" + (qs.Any() ? "?" + string.Join("&", qs) : "");
            _contracts = await Http.GetFromJsonAsync<List<Contract>>(url) ?? new();
        }
        catch { ShowAlert("Search failed.", "alert-danger"); }
        finally { _loading = false; }
    }

    private async Task ClearFilter()
    {
        _filterFrom = null; _filterTo = null; _filterStatus = string.Empty;
        await LoadContracts();
    }

    private void ConfirmDelete(Contract c) => _deleteTarget = c;

    private async Task DeleteContract()
    {
        if (_deleteTarget == null) return;
        _deleting = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/v1/contract/Delete/{_deleteTarget.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _contracts.Remove(_deleteTarget);
                ShowAlert($"Contract '{_deleteTarget.Title}' deleted.", "alert-success");
                _deleteTarget = null;
            }
            else { ShowAlert("Delete failed.", "alert-danger"); }
        }
        catch { ShowAlert("An error occurred.", "alert-danger"); }
        finally { _deleting = false; }
    }

    private void ShowAlert(string msg, string cls) { _alertMsg = msg; _alertClass = cls; }
}