@page "/contracts/{Id:int}"
@using ST10439147_PRO7311_POE.Models
@using ST10439147_PRO7311_POE.DTOs
@inject HttpClient Http
@rendermode InteractiveServer
@inject ProtectedSessionStorage SessionStorage
@inject UserState UserState
@inject NavigationManager Nav

<PageTitle>Contract #@Id – TechMove</PageTitle>

@if (!_sessionChecked)
{
    <div class="alert alert-info">Loading...</div>
}
else if (!UserState.IsLoggedIn)
{
    <div class="alert alert-info">Redirecting...</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Contract Detail</h1>
            <p>Contract #@Id</p>
        </div>
        <div style="display:flex;gap:.6rem">
            <a class="btn btn-secondary" href="contracts">← Back</a>
            @if (UserState.IsManager && _contract != null)
            {
                <a class="btn btn-warning" href="contracts/@Id/edit">✏️ Edit</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_alertMsg))
    {
        <div class="alert @_alertClass">@_alertMsg</div>
    }

    @if (_loading)
    {
        <div class="alert alert-info"><span class="spinner dark"></span> &nbsp;Loading...</div>
    }
    else if (_contract == null)
    {
        <div class="empty-state">
            <div class="empty-icon">❓</div>
            <h3>Contract not found</h3>
            <p>The contract you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                📄 @_contract.Title
                <span class="badge badge-@_contract.Status.ToString().ToLower()">@_contract.Status</span>
            </div>
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">Client</div>
                        <div class="detail-value">@(_contract.Client?.Name ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Service Level</div>
                        <div class="detail-value">@_contract.ServiceLevel</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Start Date</div>
                        <div class="detail-value">@_contract.StartDate.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">End Date</div>
                        <div class="detail-value">@_contract.EndDate.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Signed Agreement</div>
                        <div class="detail-value">
                            @if (!string.IsNullOrEmpty(_contract.SignedAgreementFileName))
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                       href="/@_contract.SignedAgreementPath" target="_blank" download="@_contract.SignedAgreementFileName">
                                    📥 @_contract.SignedAgreementFileName
                                </a>
                            }
                            else
                            {
                                <span style="color:#6c757d">No file uploaded</span>
                            }
                        </div>
                    </div>
                </div>

                @if (UserState.IsManager)
                {
                    <hr style="margin:1rem 0" />
                    <div style="display:flex;align-items:center;gap:.8rem;flex-wrap:wrap">
                        <strong style="font-size:.9rem;color:var(--primary)">Change Status:</strong>
                        @foreach (var s in Enum.GetValues<ContractStatus>())
                        {
                            @if (s != _contract.Status)
                            {
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => ChangeStatus(s)"
                                        disabled="@_statusChanging">
                                    → @s
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                🔧 Service Requests
                <button class="btn btn-sm btn-primary" @onclick="() => _showSrForm = !_showSrForm">
                    @(_showSrForm ? "✕ Cancel" : "➕ Add Request")
                </button>
            </div>
            <div class="card-body">
                @if (_showSrForm)
                {
                    <div style="background:#f8f9fa;border-radius:8px;padding:1.2rem;margin-bottom:1.2rem;border:1px solid #e2e6ea">
                        <h6 style="margin:0 0 1rem;color:var(--primary)">New Service Request</h6>
                        <div class="form-grid">
                            <div class="form-group" style="grid-column:1/-1">
                                <label>Description <span class="required">*</span></label>
                                <textarea class="form-control" rows="3" @bind="_srDescription" placeholder="Describe the service request..."></textarea>
                            </div>
                            <div class="form-group">
                                <label>Cost (USD) <span class="required">*</span></label>
                                <input type="number" class="form-control" step="0.01" min="0"
                                       @bind="_srCostUsd" @oninput="OnCostInput" placeholder="0.00" />
                            </div>
                            <div class="form-group">
                                <label>Equivalent (ZAR)</label>
                                <input class="form-control" readonly value="@_zarDisplay" />
                                <span class="form-hint">Rate: @(_rate > 0 ? $"1 USD = {_rate:F2} ZAR" : "Loading...")</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_srError))
                        {
                            <div class="alert alert-danger" style="margin-top:.8rem">@_srError</div>
                        }
                        <div style="margin-top:1rem;display:flex;gap:.6rem">
                            <button class="btn btn-success" @onclick="SubmitServiceRequest" disabled="@_srSaving">
                                @if (_srSaving)
                                {
                                    <span class="spinner"></span>
                                }
                                else
                                {
                                    <span>Submit Request</span>
                                }
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showSrForm = false">Cancel</button>
                        </div>
                    </div>
                }

                @if (!_serviceRequests.Any())
                {
                    <div class="empty-state" style="padding:2rem 0">
                        <div class="empty-icon">🔧</div>
                        <h3>No service requests</h3>
                        <p>No service requests have been submitted for this contract.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th>Cost (USD)</th>
                                    <th>Cost (ZAR)</th>
                                    <th>Rate Used</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sr in _serviceRequests)
                                {
                                    <tr>
                                        <td style="color:#6c757d;font-size:.85rem">@sr.Id</td>
                                        <td>@sr.Description</td>
                                        <td>$@sr.CostUSD.ToString("N2")</td>
                                        <td>R @sr.CostZAR.ToString("N2")</td>
                                        <td style="font-size:.82rem;color:#6c757d">@sr.ExchangeRateUsed.ToString("F4")</td>
                                        <td>
                                            @if (UserState.IsManager)
                                            {
                                                <div style="display:flex;align-items:center;gap:.4rem">
                                                    <select class="form-select form-select-sm"
                                                            style="min-width:130px"
                                                            disabled="@(_srStatusChangingId == sr.Id)"
                                                            value="@sr.Status"
                                                            @onchange="e => ChangeRequestStatus(sr, e)">
                                                        @foreach (var s in Enum.GetValues<ServiceRequestStatus>())
                                                        {
                                                            <option value="@s">@s</option>
                                                        }
                                                    </select>
                                                    @if (_srStatusChangingId == sr.Id)
                                                    {
                                                        <span class="spinner dark"></span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge badge-@sr.Status.ToString().ToLower()">@sr.Status</span>
                                            }
                                        </td>
                                        <td style="font-size:.85rem">@sr.RequestDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Contract? _contract;
    private List<ServiceRequest> _serviceRequests = new();
    private bool _loading = true;
    private bool _sessionChecked;
    private bool _statusChanging;
    private bool _showSrForm;
    private bool _srSaving;

    // Tracks which service request row is currently saving (-1 = none)
    private int _srStatusChangingId = -1;

    private string _srDescription = string.Empty;
    private decimal _srCostUsd;
    private decimal _rate;
    private string _zarDisplay = "—";
    private string _srError = string.Empty;
    private string _alertMsg = string.Empty;
    private string _alertClass = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sessionChecked)
        {
            _sessionChecked = true;
            if (!UserState.IsLoggedIn)
            {
                try
                {
                    var result = await SessionStorage.GetAsync<User>("currentUser");
                    if (result.Success && result.Value != null)
                        UserState.CurrentUser = result.Value;
                    else
                    { Nav.NavigateTo("/login"); return; }
                }
                catch { Nav.NavigateTo("/login"); return; }
            }

            await LoadContract();
            await LoadRate();
            StateHasChanged();
        }
    }

    private async Task LoadContract()
    {
        _loading = true;
        try
        {
            var dto = await Http.GetFromJsonAsync<ContractResponseDto>($"api/contracts/{Id}");
            _contract = dto?.Contract;
            if (_contract != null)
                _serviceRequests = await Http.GetFromJsonAsync<List<ServiceRequest>>(
                    $"api/contracts/{Id}/requests") ?? new();
        }
        catch { ShowAlert("Failed to load contract.", "alert-danger"); }
        finally { _loading = false; }
    }

    private async Task LoadRate()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<CurrencyRateDto>("api/currency/rate");
            if (dto != null) _rate = dto.Rate;
        }
        catch { }
    }

    private async Task OnCostInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var usd) && _rate > 0)
        { _srCostUsd = usd; _zarDisplay = $"R {(usd * _rate):N2}"; }
        else { _zarDisplay = "—"; }
        await Task.CompletedTask;
    }

    private async Task SubmitServiceRequest()
    {
        _srError = string.Empty;
        if (string.IsNullOrWhiteSpace(_srDescription)) { _srError = "Description is required."; return; }
        if (_srCostUsd <= 0) { _srError = "Cost must be greater than 0."; return; }

        _srSaving = true;
        try
        {
            var payload = new
            {
                ContractId = Id,
                Description = _srDescription,
                CostUSD = _srCostUsd,
                CostZAR = Math.Round(_srCostUsd * _rate, 2),
                ExchangeRateUsed = _rate,
                Status = ServiceRequestStatus.Pending
            };
            var resp = await Http.PostAsJsonAsync("api/contracts/requests", payload);
            if (resp.IsSuccessStatusCode)
            {
                _srDescription = string.Empty; _srCostUsd = 0; _zarDisplay = "—"; _showSrForm = false;
                _serviceRequests = await Http.GetFromJsonAsync<List<ServiceRequest>>(
                    $"api/contracts/{Id}/requests") ?? _serviceRequests;
                ShowAlert("Service request submitted.", "alert-success");
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ContractResponseDto>();
                _srError = err?.Message ?? "Submission failed.";
            }
        }
        catch { _srError = "An error occurred."; }
        finally { _srSaving = false; }
    }

    private async Task ChangeRequestStatus(ServiceRequest sr, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ServiceRequestStatus>(e.Value?.ToString(), out var newStatus))
            return;

        if (newStatus == sr.Status) return;

        _srStatusChangingId = sr.Id;
        StateHasChanged(); // show spinner immediately
        try
        {
            var resp = await Http.PatchAsJsonAsync(
                $"api/contracts/requests/{sr.Id}/status", new { Status = newStatus });

            if (resp.IsSuccessStatusCode)
            {
                sr.Status = newStatus;
                ShowAlert($"Request #{sr.Id} updated to {newStatus}.", "alert-success");
            }
            else
            {
                ShowAlert("Status update failed.", "alert-danger");
            }
        }
        catch { ShowAlert("An error occurred.", "alert-danger"); }
        finally
        {
            _srStatusChangingId = -1;
            StateHasChanged();
        }
    }

    private async Task ChangeStatus(ContractStatus newStatus)
    {
        _statusChanging = true;
        try
        {
            var resp = await Http.PatchAsJsonAsync($"api/contracts/{Id}/status", new { Status = newStatus });
            if (resp.IsSuccessStatusCode && _contract != null)
            { _contract.Status = newStatus; ShowAlert($"Status updated to {newStatus}.", "alert-success"); }
            else { ShowAlert("Status update failed.", "alert-danger"); }
        }
        catch { ShowAlert("An error occurred.", "alert-danger"); }
        finally { _statusChanging = false; }
    }

    private void ShowAlert(string msg, string cls) { _alertMsg = msg; _alertClass = cls; }
}
