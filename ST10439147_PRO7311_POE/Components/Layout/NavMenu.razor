@inject UserState UserState
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-icon">📋</span>
            GLMS
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-section-label">Main</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span> Dashboard
            </NavLink>
        </div>

        <div class="nav-section-label">Contracts</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="contracts">
                <span class="nav-icon">📄</span> All Contracts
            </NavLink>
        </div>

        @if (UserState.IsManager)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="contracts/create">
                    <span class="nav-icon">➕</span> New Contract
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="service-requests">
                <span class="nav-icon">🔧</span> Service Requests
            </NavLink>
        </div>

        @if (UserState.IsAdmin)
        {
            <div class="nav-section-label">Administration</div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="nav-icon">👥</span> Users
                </NavLink>
            </div>
        }

    </nav>
</div>

<div class="sidebar-footer">
    @if (UserState.IsLoggedIn)
    {
        <button class="btn-logout" @onclick="Logout">🚪 Logout</button>
    }
    else
    {
        <a class="nav-link" href="login">🔑 Login</a>
    }
</div>

@code {
    private void Logout()
    {
        UserState.CurrentUser = null;
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
